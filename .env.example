# Local preview without Firebase. Data stays on this device.
# Production and internal APK builds must set this to false.
EXPO_PUBLIC_DEMO_MODE=true

# Firebase public client configuration. These values identify the project.
# They are not secret keys and they do not replace Firestore Security Rules.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
